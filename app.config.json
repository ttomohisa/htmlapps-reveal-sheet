{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Reveal Sheet",
  "nameJa": "めくる暗記シート",
  "slug": "reveal-sheet",
  "version": "0.2.0",
  "description": "Create study sheets from images with rectangular covers, free reveal study, and editable JSON save/reopen.",
  "descriptionJa": "画像に四角い覆いを作って学習し、画像込み編集データを保存・再読込できる暗記シート。",
  "defaultLanguage": "auto",
  "repository": { "owner": "ttomohisa", "name": "htmlapps-reveal-sheet" },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": { "enabled": true, "output": "dist/index.self-extract.html" },
    "sizeBudget": { "readableWarningMb": 2, "selfExtractWarningMb": 1 }
  }
}
