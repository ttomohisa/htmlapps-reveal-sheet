{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browser-kitty.com/schemas/reveal-sheet-v1.schema.json",
  "title": "Reveal Sheet format 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format","schemaVersion","appVersion","kind","document"],
  "properties": {
    "format": {"const": "reveal-sheet"},
    "schemaVersion": {"const": 1},
    "appVersion": {"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "kind": {"enum":["editable","lesson"]},
    "document": {"$ref":"#/$defs/document"}
  },
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},
    "rect": {
      "type":"object","additionalProperties":false,"required":["x","y","w","h"],
      "properties":{
        "x":{"type":"number","minimum":0,"maximum":1},
        "y":{"type":"number","minimum":0,"maximum":1},
        "w":{"type":"number","exclusiveMinimum":0,"maximum":1},
        "h":{"type":"number","exclusiveMinimum":0,"maximum":1}
      }
    },
    "asset": {
      "type":"object","additionalProperties":false,
      "required":["id","mime","width","height","byteLength","dataBase64"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"mime":{"const":"image/png"},
        "width":{"type":"integer","minimum":1,"maximum":8192},
        "height":{"type":"integer","minimum":1,"maximum":8192},
        "byteLength":{"type":"integer","minimum":1,"maximum":33554432},
        "dataBase64":{"type":"string","minLength":4,"pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }
    },
    "page": {
      "type":"object","additionalProperties":false,
      "required":["id","title","description","imageId","questionOrder"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"title":{"type":"string","maxLength":120},
        "description":{"type":"string","maxLength":2000},"imageId":{"$ref":"#/$defs/id"},
        "questionOrder":{"type":"array","items":{"$ref":"#/$defs/id"},"uniqueItems":true,"maxItems":1000}
      }
    },
    "question": {
      "type":"object","additionalProperties":false,
      "required":["id","pageId","revision","maskIds","prompt","answer"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"pageId":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":1},
        "maskIds":{"type":"array","items":{"$ref":"#/$defs/id"},"minItems":1,"maxItems":50,"uniqueItems":true},
        "prompt":{"type":"string","maxLength":2000},"answer":{"type":"string","maxLength":2000}
      }
    },
    "mask": {
      "type":"object","additionalProperties":false,
      "required":["id","pageId","kind","questionId","rect"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"pageId":{"$ref":"#/$defs/id"},
        "kind":{"enum":["answer","auxiliary"]},
        "questionId":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
        "rect":{"$ref":"#/$defs/rect"}
      }
    },
    "document": {
      "type":"object","additionalProperties":false,
      "required":["id","revision","title","defaults","pages","assets","questions","masks"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":1},
        "title":{"type":"string","maxLength":120},
        "defaults":{
          "type":"object","additionalProperties":false,"required":["mode","otherAnswers"],
          "properties":{"mode":{"enum":["free","guided"]},"otherAnswers":{"enum":["hidden","visible"]}}
        },
        "pages":{"type":"array","minItems":1,"maxItems":30,"items":{"$ref":"#/$defs/page"}},
        "assets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/asset"}},
        "questions":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/question"}},
        "masks":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/mask"}}
      }
    }
  }
}
